<robot name="delta_cnc">
    <link name="base_link"/>
    <link name="link1"/>
    <link name="link2"/>
    <link name="link3"/>
    
    <joint name="joint1" type="prismatic">
        <parent link="base_link"/>
        <child link="link1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="0" upper="2000" effort="10" velocity="1"/>
    </joint>

    <joint name="joint2" type="prismatic">
        <parent link="base_link"/>
        <child link="link2"/>
        <origin xyz="0 200 0" rpy="0 0 0"/> <!-- 200 mm separation along the Y-axis -->
        <axis xyz="1 0 0"/>
        <limit lower="0" upper="2000" effort="10" velocity="1"/>
    </joint>

    <joint name="joint3" type="prismatic">
        <parent link="base_link"/>
        <child link="link3"/>
        <origin xyz="0 400 0" rpy="0 0 0"/> <!-- 200 mm separation along the Y-axis -->
        <axis xyz="1 0 0"/>
        <limit lower="0" upper="2000" effort="10" velocity="1"/>
    </joint>
</robot>